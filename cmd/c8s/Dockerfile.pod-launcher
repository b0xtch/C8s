# The pod CVM launcher: the c8s binary plus a QEMU able to launch the
# platform's confidential guests. It is the one container of a pod CVM's pod
# (docs/pod-cvm.md). Nothing in it is trusted by the guest or by a verifier.
#
# The guest's firmware and disk come from the guest image directory mounted at
# run time, so no firmware package is installed here.
#
# Bump: crane digest ubuntu:26.04
FROM ubuntu:26.04@sha256:da6fc2be547864451aa253836dd926da33623312df4a9a243e35dc877c378a78

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends qemu-system-x86 \
    && rm -rf /var/lib/apt/lists/*

COPY build/c8s /c8s

ENTRYPOINT ["/c8s", "pod-launcher", "run"]
