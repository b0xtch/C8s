[Unit]
Description=Pod CVM agent
Documentation=https://github.com/confidential-dot-ai/c8s/blob/main/docs/pod-cvm.md
Requires=c8s-pod-load.service
After=c8s-pod-load.service local-fs.target
# The agent's life is the guest's. Its instance key and its record of spent
# command ids live in its memory, so a second agent in the same guest would
# hold neither, with the first one's files and credentials still in place.
# When it stops for any reason the guest powers off, the pod restarts, and a
# fresh guest is attested from scratch.
FailureAction=poweroff-force
SuccessAction=poweroff-force

[Service]
Type=simple
# C8S_POD_PLATFORM comes from a drop-in the sync hook renders from the build's
# required platform. The = form matters: unset, systemd would drop a bare
# word, but --platform= expands to an empty value the agent rejects.
ExecStart=/usr/local/bin/c8s pod-agent run --platform=${C8S_POD_PLATFORM}
Restart=no
# Each command runs in its own child cgroup, killed whole when it ends.
Delegate=yes
# Inherited by every tenant command: no setuid bit or file capability, were
# one ever to reach the image, could raise them.
NoNewPrivileges=yes
# The agent resets this for each command it starts, so under memory pressure
# the kernel takes tenant commands first and the agent last.
OOMScoreAdjust=-900
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
