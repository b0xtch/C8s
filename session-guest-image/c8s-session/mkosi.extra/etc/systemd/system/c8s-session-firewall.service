[Unit]
Description=Session guest inbound packet filter
Documentation=https://github.com/confidential-dot-ai/c8s/blob/main/docs/sessions.md
# Before any interface is configured, so no packet meets an unfiltered guest.
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target systemd-networkd.service
Wants=network-pre.target
# The sandbox's ports must never face the guest's network. A guest that cannot
# load the filter powers off, and the agent, which requires this unit, never
# starts in it.
FailureAction=poweroff-immediate

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/c8s-session/firewall.nft

[Install]
WantedBy=multi-user.target
