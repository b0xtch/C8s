[Unit]
Description=Session guest agent
Documentation=https://github.com/confidential-dot-ai/c8s/blob/main/docs/sessions.md
Requires=c8s-session-load.service c8s-session-firewall.service
After=c8s-session-load.service c8s-session-firewall.service systemd-sysctl.service local-fs.target
# The agent's life is the guest's. Its instance key and its record of spent
# command ids live in its memory, so a second agent in the same guest would
# hold neither, with the first one's files and credentials still in place.
# When it stops for any reason the guest powers off, and whatever replaces it
# is attested from scratch.
#
# At once, with no orderly shutdown: nothing in this guest outlives it, so
# there is nothing to stop cleanly or write back. A guest that refused a bind,
# or whose sandbox ended, is gone as soon as the agent is, which frees its
# place on the host and leaves what it held no time to sit there.
#
# These two are the backstop. systemd waits five seconds before it carries out
# a FailureAction, for someone at a console to read why, so the power-off that
# counts is the ExecStopPost below.
FailureAction=poweroff-immediate
SuccessAction=poweroff-immediate

[Service]
Type=simple
# C8S_SESSION_PLATFORM comes from a drop-in the sync hook renders from the build's
# required platform. The = form matters: unset, systemd would drop a bare
# word, but --platform= expands to an empty value the agent rejects.
#
# C8S_SESSION_DEV_FLAGS is empty unless the build is a dev build, whose drop-in
# sets it. Unquoted and unbraced, an empty value adds no argument and a value
# of several words adds one for each.
Environment=C8S_SESSION_DEV_FLAGS=
ExecStart=/usr/local/bin/c8s session-agent run --platform=${C8S_SESSION_PLATFORM} --crun=/usr/bin/crun --packet-filter=/etc/c8s-session/firewall.json --disclosure-schema=/etc/c8s-session/disclosure-schema.json --bind-schema=/etc/c8s-session/bind-schema.json $C8S_SESSION_DEV_FLAGS
Restart=no
# However the agent ended. Forced twice, systemctl asks nothing of the service
# manager: it syncs and calls reboot(2) itself.
ExecStopPost=/usr/bin/systemctl poweroff --force --force
# The sandbox's container and each command get a child cgroup of their own,
# killed whole when they end.
Delegate=yes
# Inherited by the sandbox and every command run for the session: no setuid bit or file
# capability, in this image or in the sandbox's, can raise them.
NoNewPrivileges=yes
# The agent resets this for the sandbox and each command it starts, so under
# memory pressure the kernel takes the session's processes first and the agent last.
OOMScoreAdjust=-900
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
