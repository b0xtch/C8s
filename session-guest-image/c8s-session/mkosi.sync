#!/usr/bin/env bash
# mkosi sync hook for the c8s-session profile. It writes what the guest's
# init runs, /etc/c8s-session/init.json, from the build's sync-inputs: the
# platform, the role and whether this is a dev build. There is no default
# platform: an image that guessed its TEE would refuse to stage on the other
# one, and that failure belongs at build time.
set -euo pipefail
STAGE_DIR="$SRCDIR/mkosi.local/mkosi.extra"
SYNC_INPUTS="$SRCDIR/mkosi.local/.confos-sync-inputs"
PLATFORM=$(cat "$SYNC_INPUTS/platform" 2>/dev/null || true)
case "$PLATFORM" in
    tdx|snp) ;;
    *) echo "c8s-session sync: FATAL platform sync-input must be tdx or snp, got '${PLATFORM}'" >&2; exit 1 ;;
esac
[ -x "$STAGE_DIR/usr/local/bin/c8s-session-guest" ] \
    || { echo "c8s-session sync: FATAL no guest program staged at usr/local/bin/c8s-session-guest (build with session-guest-image/build)" >&2; exit 1; }
DEV=$(cat "$SYNC_INPUTS/dev" 2>/dev/null || true)
ROLE=$(cat "$SYNC_INPUTS/role" 2>/dev/null || echo session)
RESERVE=$(cat "$SYNC_INPUTS/accept-reserve" 2>/dev/null || echo 0)
PROCESSORS=$(cat "$SYNC_INPUTS/agent-processors" 2>/dev/null || echo 0)

# The guest's one service. The agent's flags are its configuration, so they
# are part of the image: the root hash covers this file.
case "$ROLE" in
    session)
        SERVICE=(/usr/local/bin/c8s-session-guest session-agent run "--platform=$PLATFORM" --crun=/usr/bin/crun
            --sandbox-init=/usr/local/bin/c8s-sandbox-init
            --packet-filter=/etc/c8s-session/firewall.json
            --disclosure-schema=/etc/c8s-session/disclosure-schema.json
            --bind-schema=/etc/c8s-session/bind-schema.json)
        # Accepted free memory a guest holds while it waits for its bind.
        if [ "$RESERVE" -gt 0 ]; then
            SERVICE+=("--accept-reserve=$RESERVE")
        fi
        # The processors the agent and its runtime keep to.
        if [ "$PROCESSORS" -gt 0 ]; then
            SERVICE+=("--processors=$PROCESSORS")
        fi
        if [ "$DEV" = 1 ]; then
            # The hardware suite serves its sandbox image from the host over
            # plain HTTP, and QEMU's user-mode network shows the guest its
            # host at 10.0.2.2. --bare lets a document name no sandbox image
            # at all: its commands then run on the guest's own file system.
            # --allow-console has the agent serve in a guest whose kernel has
            # a console, which a dev build's does.
            SERVICE+=(--sandbox-plain-http=10.0.2.2:5000 --bare --allow-console)
        fi
        ;;
    key-service)
        # The key service's image is this one with another measured service
        # where the agent is: the same boot, the same launch files, the same
        # inbound filter. A replica has no network device: it serves on its
        # socket to the host, and asks Intel's service over it.
        SERVICE=(/usr/local/bin/c8s-session-guest session-key-service run "--platform=$PLATFORM")
        if [ "$DEV" = 1 ]; then
            SERVICE+=(--allow-console)
        fi
        ;;
    *) echo "c8s-session sync: FATAL role sync-input must be session or key-service, got '${ROLE}'" >&2; exit 1 ;;
esac

# The launch files and the host's network request. A dev build's guest has
# a console device, which the step's check of the guest's devices allows.
LOAD=(/usr/local/bin/c8s-session-guest session-agent load)
if [ "$DEV" = 1 ]; then
    LOAD+=(--allow-console)
fi
if [ "$ROLE" = key-service ]; then
    # The step's check takes no network device among a replica's devices,
    # and the step sets no interface.
    LOAD+=(--no-network)
fi

# Every word above is a fixed string or the validated platform: none needs
# escaping in JSON.
json_array() {
    local out="" word
    for word in "$@"; do
        out+="${out:+, }\"$word\""
    done
    printf '[%s]' "$out"
}
mkdir -p "$STAGE_DIR/etc/c8s-session"
{
    printf '{\n'
    printf '  "hostname": "c8s-session",\n'
    printf '  "steps": [\n'
    # The launch files and the host's network request, then the inbound
    # filter: both before the service listens.
    printf '    %s,\n' "$(json_array "${LOAD[@]}")"
    printf '    %s\n' "$(json_array /usr/sbin/nft -f /etc/c8s-session/firewall.nft)"
    printf '  ],\n'
    printf '  "service": %s\n' "$(json_array "${SERVICE[@]}")"
    printf '}\n'
} > "$STAGE_DIR/etc/c8s-session/init.json"
