#!/bin/bash
set -euo pipefail

# A session's commands run as an unprivileged user on this root. With no setuid or
# setgid program left on it, that user has no way up, whatever a command does.
# Nothing in the image needs one: the init starts everything as the user it runs as.
find "$BUILDROOT" -xdev -type f -perm /6000 -exec chmod a-s {} +
if [ -n "$(find "$BUILDROOT" -xdev -type f -perm /6000 -print -quit)" ]; then
    echo "c8s-session finalize: FATAL a setuid or setgid file survived" >&2
    exit 1
fi

# The init runs these by path, and the agent runs crun. Without one of them
# the guest would power off on every boot.
for bin in usr/local/bin/c8s-session-guest usr/bin/crun usr/sbin/nft usr/sbin/mke2fs; do
    if [ ! -x "$BUILDROOT/$bin" ]; then
        echo "c8s-session finalize: FATAL /$bin is not in the image" >&2
        exit 1
    fi
done

# What the init runs, the filter the agent compares the live ruleset with,
# and the schemas the agent holds to its own definitions before it serves.
# The build wrote the schemas with the staged binary, and the sync hook the
# init's configuration.
for file in init.json firewall.nft firewall.json disclosure-schema.json bind-schema.json; do
    if [ ! -s "$BUILDROOT/etc/c8s-session/$file" ]; then
        echo "c8s-session finalize: FATAL /etc/c8s-session/$file is not in the image (build with session-guest-image/build)" >&2
        exit 1
    fi
done

# Their modes came with the build host's umask, which the root's hash must
# not depend on.
chmod 0755 "$BUILDROOT/etc/c8s-session"
find "$BUILDROOT/etc/c8s-session" -xdev -type f -exec chmod 0644 {} +

# The init gives each of these a writable layer on the state volume and
# refuses to boot an image that lists none.
if ! grep -qsxE '(var|home)' "$BUILDROOT"/usr/lib/confai/state.d/*.conf; then
    echo "c8s-session finalize: FATAL the image lists no writable state directories in /usr/lib/confai/state.d" >&2
    exit 1
fi

# A dev image runs a session's commands as this user, in its home. Nothing
# makes directories when the guest boots, so the home is part of the image:
# the writable layer over /home shows it with this owner and mode.
if entry=$(grep -E '^sandbox:' "$BUILDROOT/etc/passwd"); then
    IFS=: read -r _ _ uid gid _ home _ <<< "$entry"
    # By number: the build host's tools know none of the image's users.
    mkdir -p "$BUILDROOT$home"
    chown "$uid:$gid" "$BUILDROOT$home"
    chmod 0750 "$BUILDROOT$home"
else
    echo "c8s-session finalize: FATAL the image has no sandbox user (etc/sysusers.d/c8s-session.conf)" >&2
    exit 1
fi

# The guest has no resolver of its own. The launch files' loader writes the
# resolvers its host names to /run, and this is where a lookup finds them.
ln -sfn /run/c8s-session/resolv.conf "$BUILDROOT/etc/resolv.conf"

# The staged launch key is read through this link.
if [ "$(readlink "$BUILDROOT/etc/confai")" != ../run/confai ] && [ "$(readlink "$BUILDROOT/etc/confai")" != /run/confai ]; then
    echo "c8s-session finalize: FATAL /etc/confai does not point at /run/confai, where the init stages the launch key" >&2
    exit 1
fi

# The builder's base disables cloud-init with this marker. A session guest
# starts nothing but its own init, so cloud-init has no way to run; the
# marker is held here so that an image that ever boots another way still
# takes no configuration from its host.
if [ ! -e "$BUILDROOT/etc/cloud/cloud-init.disabled" ] && [ -e "$BUILDROOT/usr/bin/cloud-init" ]; then
    echo "c8s-session finalize: FATAL cloud-init is installed and /etc/cloud/cloud-init.disabled is missing" >&2
    exit 1
fi
