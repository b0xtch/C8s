# Guest kernel fragment for the c8s session image, merged after confos's
# required + hardening + confidential baselines.

# vsock to the host's quoting service. The agent asks QGS for a quote over
# AF_VSOCK in milliseconds; without it the only path is ConfigFS-TSM, where
# the kernel polls once a second per quote. Both symbols are needed
# (VIRTIO_VSOCKETS depends on VSOCKETS). Only root can open the TDX device
# the quote starts from. The agent listens on one vsock port, for its host's
# hand-in of Intel's collateral, which it stores unread and takes from the
# host's context id alone.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# User namespaces. The agent runs a session's OCI sandbox as root of its own
# user namespace, which holds no privilege over anything the guest's root owns.
CONFIG_USER_NS=y

# nftables, for the guest's inbound filter: only the agent's attested port
# may be reached from outside.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y

# Transparent huge pages, for the memory a sandbox asks them for (madvise).
# A TD's host maps its private memory in 4 KiB pages either way; what this
# saves is the guest's own page faults and page-table walks.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# No IPv6-in-IPv4 tunnels. Nothing in the guest uses one, and the driver puts
# a sit0 device in every network namespace, the sandbox's included.
# CONFIG_IPV6_SIT is not set
