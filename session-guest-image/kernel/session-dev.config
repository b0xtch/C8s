# Guest kernel options of every c8s session image: the lines from here to the
# end-of-common marker are the same in session.config and session-dev.config,
# and `build` fails if they are not. Merged after confos's required +
# hardening + confidential baselines.

# vsock to the guest's host. The agent asks the host's quoting service for a
# quote over AF_VSOCK in milliseconds; without it the only path is
# ConfigFS-TSM, where the kernel polls once a second per quote. It dials its
# launcher the same way for its key service and for Intel's documents. Both
# symbols are needed (VIRTIO_VSOCKETS depends on VSOCKETS). Only root can
# open the TDX device the quote starts from, and the guest listens on no
# vsock port.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# User namespaces. The agent runs a session's OCI sandbox as root of its own
# user namespace, which holds no privilege over anything the guest's root owns.
CONFIG_USER_NS=y

# nftables, for the guest's inbound filter: only the agent's attested port
# may be reached from outside.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
# The nftables ruleset is the guest's whole packet filter: no iptables table
# of the old kind beside it, and no xtables match inside it. The agent lists
# the ruleset once and from then on asks the kernel for its generation, which
# moves with every change to it. That check rests on both staying off.
# CONFIG_NETFILTER_XTABLES_LEGACY is not set
# CONFIG_NFT_COMPAT is not set

# Transparent huge pages, for the memory a sandbox asks them for (madvise).
# A TD's host maps its private memory in 4 KiB pages either way; what this
# saves is the guest's own page faults and page-table walks.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# The bounce buffer for the guest's virtio devices grows on demand. Without
# this it has one size for good, and a confidential guest's default is 6% of
# its memory up to 1 GiB, all of it turned from private to shared one page
# at a time before the first device is probed. The image's command line
# starts it at 32 MiB (swiotlb=16384).
CONFIG_SWIOTLB_DYNAMIC=y

# No IPv6-in-IPv4 tunnels. Nothing in the guest uses one, and the driver puts
# a sit0 device in every network namespace, the sandbox's included.
# CONFIG_IPV6_SIT is not set

# No driver for a device a session guest is never given. Its launcher builds
# it a network device, block devices and a vsock device, all virtio on a PCI
# bus, and nothing else: no disk controller, no network card, no input
# device, no sensor. A driver the kernel does not have cannot be reached by a
# device a host adds, and is not probed for at every boot.
# CONFIG_ETHERNET is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_BLK_DEV_MD is not set
# CONFIG_PCCARD is not set
# CONFIG_AGP is not set
# CONFIG_INTEL_MEI is not set
# CONFIG_I2C is not set
# No virtual terminal: there is no screen and no keyboard, and it is what
# keeps the input layer in. A dev image's console is a serial one.
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_PTP_1588_CLOCK is not set
# CONFIG_PPS is not set
# CONFIG_VMGENID is not set
# CONFIG_WATCHDOG is not set
# CONFIG_HWMON is not set
# CONFIG_X86_PLATFORM_DEVICES is not set
# CONFIG_MACINTOSH_DRIVERS is not set
# CONFIG_ACPI_BUTTON is not set
# CONFIG_ACPI_FAN is not set
# CONFIG_ACPI_BATTERY is not set
# CONFIG_ACPI_AC is not set
# CONFIG_SUSPEND is not set
# The thermal and CPU frequency code stays: the builder's baseline keeps the
# ACPI processor driver, which selects both. Neither has a device to drive.

# The devices it has are there when it boots. Nothing is plugged in later,
# so the kernel has no code that takes a device a host adds to a running
# guest, and none for a port that would carry one. Nor does it take code:
# its drivers are built in, and it loads no module. The agent checks its
# devices and its console once, before it serves, and a bind rests on both.
# CONFIG_HOTPLUG_PCI is not set
# CONFIG_PCIEPORTBUS is not set
# CONFIG_MODULES is not set
# Virtio devices are the current kind only: the legacy kind is driven over
# I/O ports with a layout of its own.
# CONFIG_VIRTIO_PCI_LEGACY is not set

# No file system it mounts nothing of: its volumes are erofs, ext4, overlay,
# tmpfs and the launch volume's plain ISO 9660.
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_MSDOS_FS is not set
# CONFIG_JOLIET is not set
# CONFIG_ZISOFS is not set
# CONFIG_QUOTA is not set
# CONFIG_AUTOFS_FS is not set

# Nothing of the firmware's is read or called once the kernel runs: no
# firmware variables, no runtime services, no table of the board's maker.
# CONFIG_EFIVAR_FS is not set
CONFIG_EFI_DISABLE_RUNTIME=y
# CONFIG_DMI is not set

# The agent asks the kernel for its listening TCP sockets alone, through
# sock_diag, before it starts a sandbox. The socket tables under /proc are
# walked whole for every read, the connected sockets included, and that
# table grows with the guest's memory. Only TCP answers, and nothing closes
# a socket through it.
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
# CONFIG_INET_UDP_DIAG is not set
# CONFIG_INET_RAW_DIAG is not set
# CONFIG_INET_DIAG_DESTROY is not set

# No key combination reaches the kernel: there is no keyboard and no console
# to send one from.
# CONFIG_MAGIC_SYSRQ is not set
# end of common

# The dev image only, on top of the common options: confos's dev.config (8250
# serial and debugfs). Different measurement; never ship.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_DEBUG_FS_ALLOW_ALL=y
