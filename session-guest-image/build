#!/usr/bin/env bash
# Build the c8s session guest image from THIS repo's profile, with a
# confidential-os-builder checkout as the builder (same division of labour
# as node-guest-image/build).
#
# The guest's program (cmd/c8s-session-guest: the agent, the key service and
# the command that states their schemas) is compiled here, from this
# checkout, and staged into the image, so the measured agent is exactly the
# source at this commit.
#
# Knobs:
#   C8S_PLATFORM=   REQUIRED. tdx or snp. No default: the agent refuses to
#                   stage on a TEE other than the one the image was built for.
#   C8S_DEV=1       debug build: a serial console that the kernel, the init
#                   and the agent log to. Different measurement, host-readable
#                   logs. Never ship. Default name: c8s-session-dev.
#   C8S_ROLE=key-service
#                   build the key service's image: this image with the key
#                   service as its measured service where the agent is. Its
#                   own measurement. Default name: c8s-key-service[-dev].
#   C8S_SIMTEE=1    DEVELOPMENT ONLY, and protects nothing: compile the
#                   guest's programs with the c8s_simtee tag. The image then
#                   boots with no TEE and simulates one in software: the
#                   second baseline of docs/session-performance.md. Its
#                   programs refuse to run in a confidential VM. Default
#                   name: <name>-simtee.
#   C8S_ACCEPT_RESERVE_MB=...
#                   megabytes of accepted free memory the session's agent
#                   holds while it waits for a bind (its --accept-reserve),
#                   so that a start touches none the host has yet to give.
#                   It is part of the measured service line. Default 0: a
#                   start accepts what it grows into.
#   C8S_AGENT_PROCESSORS=...
#                   how many of the guest's processors the session's agent
#                   keeps to, the first ones, with the runtime it starts
#                   containers with (its --processors). The session's own
#                   code has every one either way. Part of the measured
#                   service line. Default 0: all of them.
#   C8S_NAME=...    output name (default c8s-session -> output/c8s-session/)
#   C8S_MEMORY=...  default memory recorded in the manifest (default 1G)
#   C8S_BINARY=...  stage this prebuilt linux/amd64 c8s-session-guest and
#                   skip the compile. A reproducibility check uses it to
#                   prove two builds of one binary measure the same. Build it
#                   with GOEXPERIMENT=runtimesecret, as here: its agent runs
#                   no guest without.
#   C8S_INIT_BINARY=...
#                   the guest's init, prebuilt (cmd/c8s-session-init, static
#                   linux/amd64), in place of compiling it here.
#   C8S_SANDBOX_INIT_BINARY=...
#                   the program a sandbox's container starts with, prebuilt
#                   (cmd/c8s-sandbox-init, static linux/amd64), in place of
#                   compiling it here.
#   CONFOS_DIR=...  confos checkout to build with (default: sibling of this
#                   repo's checkout).
#   C8S_TDX_FIRMWARE=...
#                   boot this TDX firmware file. Unset, firmware/build builds
#                   it from source, once, into build/session-firmware/.
#
# Extra args are passed through to `confos build`.
set -euo pipefail
case "${C8S_PLATFORM:-}" in
tdx|snp) ;;
*)  echo "session-guest-image/build: C8S_PLATFORM must be tdx or snp, got '${C8S_PLATFORM:-}'" >&2; exit 1 ;;
esac
PGI_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_DIR=$(cd "$PGI_DIR/.." && pwd)
CONFOS_DIR=${CONFOS_DIR:-"$REPO_DIR/../confidential-os-builder"}
[ -x "$CONFOS_DIR/bin/confos" ] || { echo "session-guest-image/build: confos checkout not found at $CONFOS_DIR (set CONFOS_DIR)" >&2; exit 1; }

case "${C8S_ACCEPT_RESERVE_MB:-0}" in
''|*[!0-9]*) echo "session-guest-image/build: C8S_ACCEPT_RESERVE_MB must be a number of megabytes, got '${C8S_ACCEPT_RESERVE_MB}'" >&2; exit 1 ;;
esac
case "${C8S_AGENT_PROCESSORS:-0}" in
''|*[!0-9]*) echo "session-guest-image/build: C8S_AGENT_PROCESSORS must be a number of processors, got '${C8S_AGENT_PROCESSORS}'" >&2; exit 1 ;;
esac
case "${C8S_ROLE:-session}" in
session) DEFAULT_NAME=c8s-session ;;
key-service) DEFAULT_NAME=c8s-key-service ;;
*)  echo "session-guest-image/build: C8S_ROLE must be session or key-service, got '${C8S_ROLE}'" >&2; exit 1 ;;
esac
if [ "${C8S_ROLE:-session}" != session ] && [ "${C8S_ACCEPT_RESERVE_MB:-0}${C8S_AGENT_PROCESSORS:-0}" != 00 ]; then
    echo "session-guest-image/build: C8S_ACCEPT_RESERVE_MB and C8S_AGENT_PROCESSORS are the session agent's: the key service starts no sandbox" >&2
    exit 1
fi
FRAGMENT="$PGI_DIR/kernel/session.config"
DEV_PROFILE=()
if [ "${C8S_DEV:-0}" = 1 ]; then
    FRAGMENT="$PGI_DIR/kernel/session-dev.config"
    DEV_PROFILE=(--profile dev)
    DEFAULT_NAME=$DEFAULT_NAME-dev
fi
TAGS=()
if [ "${C8S_SIMTEE:-0}" = 1 ]; then
    [ "$C8S_PLATFORM" = tdx ] || { echo "session-guest-image/build: C8S_SIMTEE simulates TDX alone, and C8S_PLATFORM is $C8S_PLATFORM" >&2; exit 1; }
    TAGS=(-tags c8s_simtee)
    DEFAULT_NAME=$DEFAULT_NAME-simtee
fi
: "${C8S_NAME:=$DEFAULT_NAME}"

# The dev kernel is the locked kernel plus a console and debugfs. Both
# fragments open with the same lines, so that what a dev image tests is the
# kernel a locked image runs.
common() { sed '/^# end of common$/q' "$1"; }
if ! diff -q <(common "$PGI_DIR/kernel/session.config") <(common "$PGI_DIR/kernel/session-dev.config") > /dev/null \
    || ! grep -q '^# end of common$' "$PGI_DIR/kernel/session.config"; then
    echo "session-guest-image/build: kernel/session.config and kernel/session-dev.config differ before '# end of common'" >&2
    exit 1
fi

# Kernel source patches, applied in name order. Each one changes the kernel,
# and so the measurement, and is named by hash in the image's manifest.
PATCHES=()
for patch in "$PGI_DIR"/kernel/patches/*.patch; do
    [ -e "$patch" ] && PATCHES+=(--kernel-patch "$patch")
done
BUILDER_HELP=$(cd "$CONFOS_DIR" && bin/confos build --help 2>/dev/null || true)
if [ "${#PATCHES[@]}" -gt 0 ] && ! grep -q -- --kernel-patch <<<"$BUILDER_HELP"; then
    echo "session-guest-image/build: the confos checkout at $CONFOS_DIR cannot apply kernel patches (no --kernel-patch): a session kernel built without kernel/patches/ would be another kernel" >&2
    exit 1
fi
if ! grep -q -- --initrd <<<"$BUILDER_HELP"; then
    echo "session-guest-image/build: the confos checkout at $CONFOS_DIR takes no initrd of the caller's (no --initrd): a session guest boots its own init, not the builder's" >&2
    exit 1
fi

# The firmware a TDX guest boots is this image's own, built from source: its
# measurement is MRTD. SEV-SNP boots the builder's IGVM files.
FIRMWARE=()
if [ "$C8S_PLATFORM" = tdx ]; then
    if [ -z "${C8S_TDX_FIRMWARE:-}" ]; then
        C8S_TDX_FIRMWARE="$REPO_DIR/build/session-firmware/OVMF.tdx.fd"
        [ -f "$C8S_TDX_FIRMWARE" ] || "$PGI_DIR/firmware/build" "$C8S_TDX_FIRMWARE"
    fi
    [ -f "$C8S_TDX_FIRMWARE" ] || { echo "session-guest-image/build: C8S_TDX_FIRMWARE=$C8S_TDX_FIRMWARE is not a file" >&2; exit 1; }
    FIRMWARE=(--tdx-firmware "$C8S_TDX_FIRMWARE")
    echo "session-guest-image/build: firmware $(sha256sum "$C8S_TDX_FIRMWARE" | cut -d' ' -f1)  $C8S_TDX_FIRMWARE"
fi

if [ -z "${C8S_BINARY:-}" ]; then
    # -trimpath and an empty build id keep the binary a function of the
    # source and toolchain alone, so two builds of one commit measure alike.
    VERSION=$(git -C "$REPO_DIR" describe --tags --always --dirty 2>/dev/null || echo dev)
    C8S_BINARY="$REPO_DIR/build/c8s-session-guest"
    mkdir -p "$REPO_DIR/build"
    # The runtime's secret mode erases what work on the guest's one-time keys
    # leaves on a stack or the heap. The agent refuses to run without it.
    (cd "$REPO_DIR" && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOFLAGS=-buildvcs=false GOEXPERIMENT=runtimesecret \
        go build -trimpath ${TAGS[@]+"${TAGS[@]}"} \
        -ldflags "-s -w -buildid= -X github.com/confidential-dot-ai/c8s/internal/version.Version=$VERSION" \
        -o "$C8S_BINARY" ./cmd/c8s-session-guest)
fi
[ -f "$C8S_BINARY" ] || { echo "session-guest-image/build: C8S_BINARY=$C8S_BINARY is not a file" >&2; exit 1; }
echo "session-guest-image/build: staging $(sha256sum "$C8S_BINARY" | cut -d' ' -f1)  $C8S_BINARY"

# The guest's init is the one program in its initramfs, and so in the UKI:
# RTMR[2] covers it. It carries no version string: it changes only when its
# source does.
if [ -z "${C8S_INIT_BINARY:-}" ]; then
    C8S_INIT_BINARY="$REPO_DIR/build/c8s-session-init"
    mkdir -p "$REPO_DIR/build"
    (cd "$REPO_DIR" && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOFLAGS=-buildvcs=false \
        go build -trimpath ${TAGS[@]+"${TAGS[@]}"} -ldflags "-s -w -buildid=" -o "$C8S_INIT_BINARY" ./cmd/c8s-session-init)
fi
[ -f "$C8S_INIT_BINARY" ] || { echo "session-guest-image/build: C8S_INIT_BINARY=$C8S_INIT_BINARY is not a file" >&2; exit 1; }

# A program compiled to simulate a TEE names the tag in its own text. It goes
# in an image built for that and in no other, whoever compiled it: an image
# with one such program and one that is not would boot in neither kind of
# guest, and a release image with one would attest to nobody.
for program in "$C8S_BINARY" "$C8S_INIT_BINARY"; do
    if grep -aq '(c8s_simtee)' "$program"; then
        [ "${C8S_SIMTEE:-0}" = 1 ] || { echo "session-guest-image/build: $program simulates a TEE (it was compiled with -tags c8s_simtee): it goes in no image but one built with C8S_SIMTEE=1" >&2; exit 1; }
    elif [ "${C8S_SIMTEE:-0}" = 1 ]; then
        echo "session-guest-image/build: C8S_SIMTEE=1 and $program was compiled without -tags c8s_simtee" >&2; exit 1
    fi
done

# The program a sandbox's container runs until its session is bound. It is
# started from a descriptor inside a container that holds no file of the
# guest's, so it links nothing. Like the init, it carries no version string.
if [ -z "${C8S_SANDBOX_INIT_BINARY:-}" ]; then
    C8S_SANDBOX_INIT_BINARY="$REPO_DIR/build/c8s-sandbox-init"
    mkdir -p "$REPO_DIR/build"
    (cd "$REPO_DIR" && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOFLAGS=-buildvcs=false \
        go build -trimpath -ldflags "-s -w -buildid=" -o "$C8S_SANDBOX_INIT_BINARY" ./cmd/c8s-sandbox-init)
fi
[ -f "$C8S_SANDBOX_INIT_BINARY" ] || { echo "session-guest-image/build: C8S_SANDBOX_INIT_BINARY=$C8S_SANDBOX_INIT_BINARY is not a file" >&2; exit 1; }
# One file and the directories it mounts on, every entry with the same owner
# and time and in name order: the archive is a function of the init alone.
INITRD="$REPO_DIR/build/session-initrd.cpio.gz"
mkdir -p "$REPO_DIR/build"
INITRD_TREE=$(mktemp -d)
install -m 0755 "$C8S_INIT_BINARY" "$INITRD_TREE/init"
for dir in dev proc sys sysroot state opkey run; do
    mkdir -m 0755 "$INITRD_TREE/$dir"
done
find "$INITRD_TREE" -exec touch -h -d @0 {} +
(cd "$INITRD_TREE" && find . -mindepth 1 | LC_ALL=C sort | cpio --quiet -o -H newc --owner=0:0 --reproducible) | gzip -n -9 > "$INITRD"
rm -rf "${INITRD_TREE:?}"
echo "session-guest-image/build: initrd $(sha256sum "$INITRD" | cut -d' ' -f1)  $INITRD (init $(sha256sum "$C8S_INIT_BINARY" | cut -d' ' -f1))"

cd "$CONFOS_DIR"
STAGE=mkosi/base/mkosi.local/mkosi.extra
install -D -m 0755 "$C8S_BINARY" "$STAGE/usr/local/bin/c8s-session-guest"
install -D -m 0755 "$C8S_SANDBOX_INIT_BINARY" "$STAGE/usr/local/bin/c8s-sandbox-init"
# What the agent in this binary says to a caller without a key, and what it
# takes in a bind, as the binary itself states them. Both go on the measured
# root, where the agent holds them to its own definitions before it serves,
# and beside the manifest, where a verifier reads them.
install -d "$STAGE/etc/c8s-session"
for schema in disclosure bind; do
    "$C8S_BINARY" schema "$schema" > "$STAGE/etc/c8s-session/$schema-schema.json" \
        || { echo "session-guest-image/build: $C8S_BINARY did not print its $schema schema (it runs on this machine: linux/amd64)" >&2; exit 1; }
done
bin/confos build "$C8S_NAME" \
    ${DEV_PROFILE[@]+"${DEV_PROFILE[@]}"} \
    --profile-dir "$PGI_DIR/c8s-session" \
    --sync-input "platform=${C8S_PLATFORM}" \
    --sync-input "dev=${C8S_DEV:-0}" \
    --sync-input "role=${C8S_ROLE:-session}" \
    --sync-input "accept-reserve=${C8S_ACCEPT_RESERVE_MB:-0}" \
    --sync-input "agent-processors=${C8S_AGENT_PROCESSORS:-0}" \
    --kernel-config-fragment "$FRAGMENT" \
    ${PATCHES[@]+"${PATCHES[@]}"} \
    ${FIRMWARE[@]+"${FIRMWARE[@]}"} \
    --initrd "$INITRD" \
    --platform "$C8S_PLATFORM" \
    --memory "${C8S_MEMORY:-1G}" \
    "$@"
[ -f "output/$C8S_NAME/manifest.json" ] \
    || { echo "session-guest-image/build: no output/$C8S_NAME/manifest.json to publish the schemas beside" >&2; exit 1; }
# The builder clears its staging area. The binary prints the same bytes again.
for schema in disclosure bind; do
    "$C8S_BINARY" schema "$schema" > "output/$C8S_NAME/$schema-schema.json"
done
echo "session-guest-image/build: published output/$C8S_NAME/disclosure-schema.json and bind-schema.json"
if [ "${C8S_SIMTEE:-0}" = 1 ]; then
    # Beside the manifest, so that nobody takes its reference values for a
    # confidential guest's: no TEE ever measures this image.
    cat > "output/$C8S_NAME/SIMULATED-TEE" <<'NOTE'
This image was built with C8S_SIMTEE=1. Its programs simulate a TEE in
software and refuse to run in a confidential VM. It protects nothing. The
registers in manifest.json are what a launcher declares for it
(c8s session-launcher run --simulated-tee); no hardware measures them.
NOTE
    echo "session-guest-image/build: output/$C8S_NAME simulates its TEE: see SIMULATED-TEE there"
fi
